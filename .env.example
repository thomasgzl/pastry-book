# Copier en .env.local et renseigner les valeurs réelles. Ne jamais committer .env.local.

# Supabase — exposées au navigateur (clé publique anonyme uniquement)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — serveur uniquement, jamais exposée au client
SUPABASE_SERVICE_ROLE_KEY=

# IA — serveur uniquement, jamais exposée au client
OPENAI_API_KEY=

# true = mode démonstration déterministe, aucun appel IA payant
DEMO_MODE=true
